# Tech Atlas — environment settings.
# Connections, secrets, and default provider/model only (same rule as radar-service).

MONGO_URI=mongodb://localhost:27017
MONGO_DB=tech_atlas

MODEL_PROVIDER=openai               # anthropic | openai
MODEL_NAME=gpt-5.6-luna             # OpenAI's high-volume model ($0.20/M in, $1.20/M out)

# Crawl + run behaviour
SCRAPE_MAX_DEPTH=8                  # how many link levels a scout may follow
SOURCES_PER_SCOUT=5                 # sources handed to each scout
SCOUT_CONCURRENCY=5                 # scouts running at the same time
SCRAPE_DELAY_SECONDS=1              # politeness delay between fetches per source
INCLUDE_PAID_SOURCES=false          # false = skip sources that need a subscription (cost=licensed)
KEEP_FULL_TEXT_RUNS=10              # retention: full text kept for the last N runs
# JOBS_IN_WORKER=false             # docker compose sets it to true: jobs run in the `worker` container
USE_PLAYWRIGHT=true                 # headless browser for JS pages + 'show more' clicking
SHOW_MORE_CLICKS=3                  # how many times the browser clicks show/load-more

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Resolve + scoring behaviour
MIN_DOCS_PER_TECH=1                 # minimum evidence docs before a tech is scored
RESOLVE_BATCH_SIZE=4000             # mentions resolved per batch
RESOLVE_KNOWN_LIMIT=1500            # known-tech list size passed to the resolver
SCORING_CONCURRENCY=6               # scoring calls running at the same time

# Data sources (free APIs) — optional; a data source whose keys are missing
# shows "not configured" and the run carries on. How to get each: README.
CONTACT_EMAIL=                      # sent to SEC (required there) and USAJOBS; never to websites
EPO_OPS_KEY=                        # EPO Open Patent Services (patents)
EPO_OPS_SECRET=
OPENALEX_API_KEY=                   # OpenAlex (papers, grants) — works without; a key gives 10× the daily budget
USAJOBS_API_KEY=                    # USAJOBS (US federal job postings), used with CONTACT_EMAIL
