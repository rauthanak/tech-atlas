{
  "settings": [
    {
      "name": "crawl",
      "skip_url_patterns": [
        "login",
        "signin",
        "signup",
        "register",
        "privacy",
        "terms",
        "cookie",
        "mailto:",
        "javascript:",
        "/tag/",
        "/tags/",
        "/category/",
        "/author/",
        "facebook.com",
        "twitter.com",
        "x.com/",
        "linkedin.com",
        "youtube.com",
        "instagram.com"
      ],
      "pages_per_source": 150,
      "page_part_chars": 1200000,
      "page_part_concurrency": 4,
      "lookback_days": 30,
      "link_depth": 8,
      "links_per_level": null
    },
    {
      "name": "radar",
      "wake_after_pages": 10,
      "default_time_zone": "America/Chicago",
      "evidence_floor": 3,
      "classify_after_collection": true,
      "classify_pages_cap": 10,
      "emerging_availability": [
        "research",
        "pilot",
        "early_commercial"
      ],
      "find_evidence_results": 5,
      "frontier_near_band": 0.5,
      "frontier_too_early": true
    }
  ]
}
